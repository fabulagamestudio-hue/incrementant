  - m_Id: 391819835707410
    m_Localized: 5 ATAQUES VENCIDOS
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707411
    m_Localized: 50 ADULTAS
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901696
    m_Localized: Jardim da rainha
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901697
    m_Localized: Nutrientes prontos perto da rainha entram direto no saldo, sem transporte
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901698
    m_Localized: "Ninhada g\xEAmea"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901699
    m_Localized: "10% dos ovos viram duas larvas pelo pre\xE7o de uma"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901700
    m_Localized: "Dep\xF3sito de constru\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901701
    m_Localized: "Libera o pincel do dep\xF3sito de constru\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901702
    m_Localized: "Dep\xF3sito de \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901703
    m_Localized: "Libera o pincel do dep\xF3sito de \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901704
    m_Localized: "Log\xEDstica integrada"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901705
    m_Localized: "Formigas sem tarefa levam os itens para o dep\xF3sito mais perto
      de quem vai usar"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901706
    m_Localized: Sala Gotas de orvalho
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901707
    m_Localized: Libera o pincel da sala de orvalho
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901708
    m_Localized: Folhas coletoras
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901709
    m_Localized: "Cada gota de orvalho rende o dobro de \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901710
    m_Localized: Neblina do amanhecer
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901711
    m_Localized: "As gotas tamb\xE9m regam os canteiros vizinhos da sala"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901712
    m_Localized: Despejo organizado
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901713
    m_Localized: "Mais 2 sa\xEDdas para despejar terra (4 \u2192 6)"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901714
    m_Localized: Rotas batidas
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901715
    m_Localized: "T\xFAneis muito usados viram trilhas: +10% de velocidade dentro
      do formigueiro"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901716
    m_Localized: Trilha de forrageio
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901717
    m_Localized: "Formigas andam 10% mais r\xE1pido fora do formigueiro"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901718
    m_Localized: Jardim cultivado
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901719
    m_Localized: Plantas cortadas perto da entrada voltam a crescer no mesmo lugar
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901720
    m_Localized: Entradas vigiadas
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901721
    m_Localized: "O aviso de ataque chega 4 s mais cedo (8 \u2192 12 s)"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901722
    m_Localized: "C\xE2mara de ref\xFAgio"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901723
    m_Localized: "Libera o pincel de ref\xFAgio: no aviso de ataque, crias e cuidadoras
      v\xE3o para l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901724
    m_Localized: Postura em campo
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901725
    m_Localized: "A rainha tamb\xE9m p\xF5e ovos quando est\xE1 coletando ou na sala
      de nutrientes"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901726
    m_Localized: "Oper\xE1ria vers\xE1til"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901727
    m_Localized: "Sem especialista por perto, a oper\xE1ria faz a tarefa dela com
      metade do b\xF4nus"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901728
    m_Localized: Comboio
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901729
    m_Localized: "Grupos de carregadoras levam pe\xE7as grandes inteiras direto ao
      dep\xF3sito"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901730
    m_Localized: Poda seletiva
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901731
    m_Localized: "Plantas cortadas por cortadeiras voltam a crescer 50% mais r\xE1pido"
