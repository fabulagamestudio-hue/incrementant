      m_Items: []
  - m_Id: 391819839901766
    m_Localized: "Ferom\xF4nio de trilha"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901767
    m_Localized: "Formigas andam 3% mais r\xE1pido fora do formigueiro por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901768
    m_Localized: Faro
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901769
    m_Localized: "Formigas acham plantas 5% mais longe por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901770
    m_Localized: "Paredes refor\xE7adas"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901771
    m_Localized: "Cupins levam 10% mais tempo para quebrar paredes por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901772
    m_Localized: Vigias
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901773
    m_Localized: "O aviso de ataque chega 1 s mais cedo por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901774
    m_Localized: Fertilidade
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901775
    m_Localized: "A rainha p\xF5e ovos 3% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901776
    m_Localized: Geleia real
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901777
    m_Localized: "Cada cria custa 2% menos alimento por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901778
    m_Localized: Vigor real
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901779
    m_Localized: "A rainha tem 10% mais vida por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901780
    m_Localized: Passo firme
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901781
    m_Localized: "Oper\xE1rias andam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901782
    m_Localized: Vitalidade
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901783
    m_Localized: "Todas as adultas t\xEAm 10% mais vida em combate por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901784
    m_Localized: "Mand\xEDbula de trabalho"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901785
    m_Localized: "Oper\xE1rias cortam plantas 3% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901786
    m_Localized: Costas largas
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901787
    m_Localized: "Carregadoras levam +1 peda\xE7o de planta por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901788
    m_Localized: Passo de carga
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901789
    m_Localized: "Carregadoras andam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901790
    m_Localized: Serrilha
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901791
    m_Localized: "Cortadeiras cortam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901792
    m_Localized: "Mand\xEDbulas de p\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901793
    m_Localized: "Escavadoras cavam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901794
    m_Localized: Carga de terra
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901795
    m_Localized: "Escavadoras levam +1 de terra por viagem por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901796
    m_Localized: Britador
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901797
    m_Localized: "Escavadoras quebram rocha 6% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901798
    m_Localized: "M\xE3os verdes"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901799
    m_Localized: "Jardineiras deixam os canteiros 5% mais r\xE1pidos por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901800
    m_Localized: Orvalheira
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901801
    m_Localized: "Jardineiras fazem as gotas de orvalho cair 10% mais r\xE1pido por
      n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901802
    m_Localized: Ninhada atenta
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901803
    m_Localized: "Cuidadoras param 5% menos entre um cuidado e outro por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901804
    m_Localized: Turno dobrado
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901805
    m_Localized: "Cada cuidadora atende +1 parte do ber\xE7\xE1rio por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901806
    m_Localized: "Mand\xEDbulas afiadas"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901807
    m_Localized: "Soldados causam 8% mais dano por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901808
    m_Localized: "Carapa\xE7a grossa"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901809
    m_Localized: "Soldados t\xEAm 8% mais vida por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901810
    m_Localized: "Recupera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901811
    m_Localized: "Soldados feridos come\xE7am a se curar 5% mais cedo por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 631342899523584
    m_Localized: Postos de guarda
    m_Metadata:
      m_Items: []
  - m_Id: 631342945660928
    m_Localized: "No ataque, soldados guardam as entradas at\xE9 um cupim chegar"
    m_Metadata:
      m_Items: []
  - m_Id: 631342945660929
    m_Localized: Corrida com carga
    m_Metadata:
      m_Items: []
  - m_Id: 631342945660930
    m_Localized: "Carregadoras com carga na m\xE3o andam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 631342945660931
    m_Localized: "F\xFAria de batalha"
    m_Metadata:
      m_Items: []
  - m_Id: 631342945660932
    m_Localized: "Soldados andam 5% mais r\xE1pido enquanto est\xE3o em batalha,
      por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 688793124466688
    m_Localized: TEM O REQUISITO
    m_Metadata:
      m_Items: []
  - m_Id: 688793124466689
    m_Localized: FALTA O REQUISITO
    m_Metadata:
      m_Items: []
  - m_Id: 688793124466690
    m_Localized: O QUE ELA LIBERA
    m_Metadata:
      m_Items: []
  - m_Id: 781892664291328
    m_Localized: "O pincel pinta: {0}. Cada \xE1rea guarda o pr\xF3prio modo."
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262848
    m_Localized: Restos em folhas
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262849
    m_Localized: "Folhas em \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262850
    m_Localized: "Terra em areia e \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262851
    m_Localized: "Pinta uma \xE1rea para entulho e restos de cupim. O entulho some;
      os restos viram folhas, que as formigas levam ao dep\xF3sito de alimentos ou
      aos canteiros."
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262852
    m_Localized: "Pinta uma \xE1rea s\xF3 para restos de cupim. As folhas deles ficam
      na \xE1rea e viram \xE1gua (1 folha, 1 \xE1gua). A \xE1gua vai ao dep\xF3sito
      de \xE1gua ou aos canteiros."
    m_Metadata:
      m_Items: []
  - m_Id: 781892685262853
    m_Localized: "Pinta uma \xE1rea s\xF3 para terra: as formigas trazem a terra
      solta de fora e a cavada que iria ao despejo, e ela vira areia e \xE1gua (1
      terra, 1 areia e 1 \xE1gua). A areia vai ao dep\xF3sito de areia (ou ao despejo);
      a \xE1gua, ao dep\xF3sito de \xE1gua ou aos canteiros."
    m_Metadata:
      m_Items: []
  - m_Id: 781892689457152
    m_Localized: Filtragem da terra
    m_Metadata:
      m_Items: []
  - m_Id: 781892689457153
    m_Localized: "A terra vira areia e \xE1gua 2\xD7 mais r\xE1pido na \xE1rea de
      res\xEDduos"
    m_Metadata:
      m_Items: []
  - m_Id: 781912851476480
    m_Localized: RESTOS EM FOLHAS
    m_Metadata:
      m_Items: []
  - m_Id: 781913384153088
    m_Localized: "FOLHAS EM \xC1GUA"
    m_Metadata:
      m_Items: []
  - m_Id: 781913937801216
    m_Localized: "TERRA EM AREIA E \xC1GUA"
    m_Metadata:
      m_Items: []
  - m_Id: 938790323613696
    m_Localized: BLOQUEAR OBRA EM SALAS
    m_Metadata:
      m_Items: []
  - m_Id: 966333848219648
    m_Localized: Trabalhando como {0}
    m_Metadata:
      m_Items: []
  - m_Id: 966333852413952
    m_Localized: "A rainha trabalha como {0} e n\xE3o p\xF5e ovos fora da sala. Agora:
      {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 966333852413953
    m_Localized: "Escolha o que a rainha faz: botar ovos ou trabalhar como uma das
      classes j\xE1 liberadas."
    m_Metadata:
      m_Items: []
  - m_Id: 966333852413954
    m_Localized: "A rainha trabalha como {0}, com o mesmo comportamento dessa classe
      (sem trabalho dela, faz o da oper\xE1ria). Respeita as se\xE7\xF5es paradas,
      mas n\xE3o os limites. Fora da sala, n\xE3o p\xF5e ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 981771277692928
    m_Localized: "\xC1rea: {0}/{1} c\xE9lulas \xB7 salas: {2}/{3}."
    m_Metadata:
      m_Items: []
  - m_Id: 981771277692929
    m_Localized: "Sem \xE1rea livre: apague uma parte ou compre mais \xE1rea na Evolu\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887232
    m_Localized: Sala de orvalho ampla
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887233
    m_Localized: "Pode pintar +20 c\xE9lulas de sala de orvalho por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887234
    m_Localized: Sala de nutrientes ampla
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887235
    m_Localized: "Pode pintar +30 c\xE9lulas de sala de nutrientes por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887236
    m_Localized: "Ber\xE7\xE1rio amplo"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887237
    m_Localized: "Pode pintar +40 c\xE9lulas de ber\xE7\xE1rio por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887238
    m_Localized: "Dep\xF3sitos amplos"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887239
    m_Localized: "Pode pintar +30 c\xE9lulas de cada dep\xF3sito por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887240
    m_Localized: "\xC1rea de res\xEDduos ampla"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887241
    m_Localized: "Pode pintar +24 c\xE9lulas de \xE1rea de res\xEDduos por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887242
    m_Localized: Sala real ampla
    m_Metadata:
      m_Items: []
  - m_Id: 981771281887243
    m_Localized: "Pode pintar +40 c\xE9lulas de sala da rainha por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1009555442102272
    m_Localized: Salas extras
    m_Metadata:
      m_Items: []
  - m_Id: 1009555446296576
    m_Localized: "Cada ambiente pode ter +1 sala separada por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1042029408808960
    m_Localized: BRILHO (BLOOM)
    m_Metadata:
      m_Items: []
  - m_Id: 1046201222950912
    m_Localized: Cogumelo luminoso
    m_Metadata:
      m_Items: []
  - m_Id: 1046201222950913
    m_Localized: "Cogumelo luminoso: clique numa c\xE9lula do t\xFAnel encostada
      na terra. Uma formiga leva at\xE9 l\xE1 um cogumelo colhido dos pulg\xF5es
      e o planta; ele ilumina os t\xFAneis em volta. Bot\xE3o direito desmarca; para
      tirar um cogumelo, cave-o."
    m_Metadata:
      m_Items: []
  - m_Id: 1046223054303232
    m_Localized: COGUMELO LUMINOSO
    m_Metadata:
      m_Items: []
  - m_Id: 1105348362629120
    m_Localized: Cuspideira
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823424
    m_Localized: Lixeira
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823425
    m_Localized: "Cuspideira: cospe \xE1cido nos cupins de longe, sem chegar perto
      da mordida deles."
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823426
    m_Localized: "Lixeira: tira os corpos dos cupins, leva os itens soltos e abastece
      a \xE1rea de res\xEDduos."
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823427
    m_Localized: Cuspideira
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823428
    m_Localized: "Nova classe, depois do primeiro ataque de cupins: cospe \xE1cido
      nos cupins a at\xE9 8 c\xE9lulas"
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823429
    m_Localized: Lixeira
    m_Metadata:
      m_Items: []
  - m_Id: 1105348366823430
    m_Localized: "Nova classe, depois do primeiro ataque de cupins: tira os corpos,
      leva os itens soltos e abastece a \xE1rea de res\xEDduos antes de tudo"
    m_Metadata:
      m_Items: []
  - m_Id: 1105374124044288
    m_Localized: LIXEIRA
    m_Metadata:
      m_Items: []
  - m_Id: 1105374728024064
    m_Localized: CUSPIDEIRA
    m_Metadata:
      m_Items: []
  - m_Id: 1308943372644352
    m_Localized: "Fazenda de pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810176
    m_Localized: "Dep\xF3sito de areia"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810177
    m_Localized: Fazendeira
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810178
    m_Localized: "ATR\xC1S DOS PULG\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810179
    m_Localized: Fazenda
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810180
    m_Localized: "Cogumelos guardados: {0}. Eles v\xEAm da ordenha dos pulg\xF5es
      na fazenda e ficam no dep\xF3sito de cogumelos."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810181
    m_Localized: "Dep\xF3sito de areia: guarda a areia cavada e a que sai da fazenda
      e dos res\xEDduos. \xC9 a comida dos pulg\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943397810182
    m_Localized: "Fazenda de pulg\xF5es: os pulg\xF5es nascem nas baias do ch\xE3o,
      cada uma com um cocho de areia e um de \xE1gua. Sozinhos, s\xF3 pingam \xE1gua;
      ordenhados pela fazendeira, comem e d\xE3o areia, folhas, \xE1gua e \xE0s vezes
      cogumelos luminosos."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004480
    m_Localized: "Fazenda de pulg\xF5es: bloqueada at\xE9 voc\xEA comprar a c\xE2mara
      Fazenda de pulg\xF5es em Evolu\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004481
    m_Localized: "Falta: pintar a fazenda (Ambientes > Fazenda de pulg\xF5es)."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004482
    m_Localized: "Falta: espa\xE7o para baias. Cave a fazenda com ch\xE3o reto de
      pelo menos {0} c\xE9lulas."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004483
    m_Localized: "O primeiro pulg\xE3o nasce em {0} s."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004484
    m_Localized: "Pulg\xF5es: {0}/{1} em {2} baias; {3} cochos vazios."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004485
    m_Localized: "Sem fazendeira, os pulg\xF5es s\xF3 pingam \xE1gua."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004486
    m_Localized: "Fazendeira: enche os cochos dos pulg\xF5es com areia e \xE1gua
      e os ordenha na fazenda."
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004487
    m_Localized: Fazendeira
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004488
    m_Localized: "Nova classe, com a fazenda de pulg\xF5es: enche os cochos de areia
      e \xE1gua e ordenha os pulg\xF5es, que ent\xE3o d\xE3o areia, folhas e \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004489
    m_Localized: Ordenha cuidadosa
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004490
    m_Localized: "Fazendeiras ordenham os pulg\xF5es 50% mais r\xE1pido"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004491
    m_Localized: "Dep\xF3sito de areia"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004492
    m_Localized: "Libera o pincel do dep\xF3sito de areia, a comida dos pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004493
    m_Localized: "Fazenda de pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004494
    m_Localized: "Libera o pincel da fazenda: os pulg\xF5es nascem nas baias e, ordenhados,
      d\xE3o areia, folhas, \xE1gua e cogumelos luminosos"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004495
    m_Localized: "Ninhada de pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004496
    m_Localized: "Os pulg\xF5es nascem 2\xD7 mais r\xE1pido"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004497
    m_Localized: Rebanho
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004498
    m_Localized: "A fazenda cria +1 pulg\xE3o por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004499
    m_Localized: Ordenha
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004500
    m_Localized: "A ordenha dos pulg\xF5es fica 5% mais r\xE1pida por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004501
    m_Localized: Fazenda ampla
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004502
    m_Localized: "Pode pintar +20 c\xE9lulas de fazenda por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004503
    m_Localized: Passo de pastora
    m_Metadata:
      m_Items: []
  - m_Id: 1308943402004504
    m_Localized: "Fazendeiras andam 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 1308972124598272
    m_Localized: "FAZENDA DE PULG\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 1308973739405312
    m_Localized: "DEP\xD3SITO DE AREIA"
    m_Metadata:
      m_Items: []
  - m_Id: 1308975454875648
    m_Localized: FAZENDEIRA
    m_Metadata:
      m_Items: []
  - m_Id: 1310793933123584
    m_Localized: Postura
    m_Metadata:
      m_Items: []
  - m_Id: 1310793937317888
    m_Localized: "A sala da rainha, onde ela p\xF5e os ovos"
    m_Metadata:
      m_Items: []
  - m_Id: 1310793937317889
    m_Localized: "T\xFAnel comum"
    m_Metadata:
      m_Items: []
  - m_Id: 1310793937317890
    m_Localized: "Os t\xFAneis do formigueiro"
    m_Metadata:
      m_Items: []
  - m_Id: 1312784897929216
    m_Localized: "Dep\xF3sito de cogumelos"
    m_Metadata:
      m_Items: []
  - m_Id: 1312784897929217
    m_Localized: "Dep\xF3sito de cogumelos: guarda os cogumelos luminosos que os
      pulg\xF5es d\xE3o na ordenha. O pincel Cogumelo luminoso busca os cogumelos
      daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 1312784902123520
    m_Localized: "Dep\xF3sito de cogumelos"
    m_Metadata:
      m_Items: []
  - m_Id: 1312784902123521
    m_Localized: "Libera o pincel do dep\xF3sito de cogumelos, onde ficam os cogumelos
      luminosos dos pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1312804879593472
    m_Localized: "DEP\xD3SITO DE COGUMELOS"
    m_Metadata:
      m_Items: []
  - m_Id: 1374681114472448
    m_Localized: "Esconder ambientes: a pintura das salas e dos dep\xF3sitos some
      do terreno. Com um pincel de ambiente na m\xE3o, ela volta a aparecer."
    m_Metadata:
      m_Items: []
  - m_Id: 1374681118666752
    m_Localized: "Mostrar ambientes: a pintura das salas e dos dep\xF3sitos volta
      a aparecer no terreno."
    m_Metadata:
      m_Items: []
  - m_Id: 1407114580979712
    m_Localized: "VERS\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339840
    m_Localized: ATUAL
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339841
    m_Localized: NOVIDADES
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339842
    m_Localized: "AJUSTES E CORRE\xC7\xD5ES"
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339843
    m_Localized: REMOVIDO
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339844
    m_Localized: BUGS CONHECIDOS
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339845
    m_Localized: "Esta vers\xE3o n\xE3o tem notas."
    m_Metadata:
      m_Items: []
  - m_Id: 1407114610339846
    m_Localized: "Nenhuma vers\xE3o publicada ainda."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372683210752
    m_Localized: Bem-vindo ao formigueiro
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182272
    m_Localized: "Agora \xE9 com voc\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182273
    m_Localized: "Pr\xF3ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182274
    m_Localized: Voltar
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182275
    m_Localized: Explorar
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182276
    m_Localized: "Aqui voc\xEA n\xE3o controla cada formiga: voc\xEA marca onde cavar
      e construir, decide para que serve cada sala e as formigas fazem o resto. Vamos
      conhecer a tela. O jogo fica pausado durante o tour e voc\xEA pode clicar em
      tudo enquanto isso."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182277
    m_Localized: "C\xE2mera"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182278
    m_Localized: "Mova a vista com WASD, as setas ou arrastando com o bot\xE3o do
      meio do mouse. Role o mouse (ou Q/E) para aproximar e afastar. O formigueiro
      \xE9 a terra embaixo; a rainha est\xE1 no abrigo."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182279
    m_Localized: Nutrientes
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182280
    m_Localized: "A moeda da col\xF4nia. As formigas cultivam canteiros na sala de
      nutrientes; a rainha come nutrientes para p\xF4r ovos e voc\xEA os gasta na
      Evolu\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182281
    m_Localized: Formigas
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182282
    m_Localized: "Adultas / vagas de adulta e as crias (ovos, larvas e pupas). As
      vagas v\xEAm da \xE1rea escavada: cavar mais abre espa\xE7o para mais formigas."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182283
    m_Localized: Rainha
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182284
    m_Localized: "O estado da rainha. Para p\xF4r ovos ela precisa da pr\xF3pria
      sala, de um ber\xE7\xE1rio, de vaga e de nutrientes; o cart\xE3o diz o que
      est\xE1 faltando."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182285
    m_Localized: Ferramenta
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182286
    m_Localized: "Pinc\xE9is do mapa. Cavar marca a terra que as formigas tiram;
      Construir marca onde elas p\xF5em terra; Cogumelo luminoso ilumina os t\xFAneis;
      o Dedo fere cupins. Bot\xE3o esquerdo marca, direito desmarca."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182287
    m_Localized: Ambientes
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182288
    m_Localized: "Pinte o espa\xE7o escavado para dar uma fun\xE7\xE3o a ele: sala
      da rainha, de nutrientes, ber\xE7\xE1rio, res\xEDduos, orvalho, pulg\xF5es
      e dep\xF3sitos. A barra embaixo de cada bot\xE3o mostra a \xE1rea que ainda
      d\xE1 para pintar. Bot\xF5es apagados ainda n\xE3o foram liberados."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182289
    m_Localized: Menu da rainha
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182290
    m_Localized: "Escolha o tipo da pr\xF3xima formiga (ou deixe no autom\xE1tico),
      pause a postura de ovos e decida se a rainha se defende ou ataca os cupins."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182291
    m_Localized: "Evolu\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182292
    m_Localized: "Gaste nutrientes em novas classes de formiga e em melhorias. Arraste
      para mover a \xE1rvore, role para aproximar e clique num n\xF3 para ver efeito,
      custo e requisitos."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182293
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182294
    m_Localized: "Pausa e retoma o jogo (tecla P). Pausado, voc\xEA ainda pode marcar
      e pintar: as formigas come\xE7am quando o jogo voltar."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182295
    m_Localized: "Painel da col\xF4nia"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182296
    m_Localized: "Estat\xEDsticas das formigas e da produ\xE7\xE3o, e quais trabalhos
      ficam ativos. Ali voc\xEA para uma se\xE7\xE3o ou limita quantas formigas trabalham
      nela."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182297
    m_Localized: Sino
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182298
    m_Localized: "Chama as formigas de volta ao formigueiro: elas terminam o que
      carregam e param. Toque de novo para mand\xE1-las de volta ao trabalho."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182299
    m_Localized: Mostrar ambientes
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182300
    m_Localized: "Esconde ou mostra a pintura das salas no terreno. As salas continuam
      funcionando; \xE9 s\xF3 para ver melhor a terra e as formigas."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182301
    m_Localized: Cupins
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182302
    m_Localized: "De tempos em tempos os cupins atacam. Um alerta aparece no alto
      da tela e cada cupim ganha um c\xEDrculo vermelho (ou uma seta na borda). Se
      matarem a rainha, a partida acaba."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182303
    m_Localized: "Dicas e gloss\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182304
    m_Localized: "Pare o mouse sobre qualquer bot\xE3o ou cart\xE3o para ver o que
      ele faz e o que est\xE1 faltando. Este bot\xE3o abre o gloss\xE1rio, com a
      explica\xE7\xE3o de cada parte do jogo; ele tamb\xE9m est\xE1 no menu do ESC
      (salvar, carregar e configura\xE7\xF5es)."
    m_Metadata:
      m_Items: []
  - m_Id: 1415372704182305
    m_Localized: "O jogo volta a correr quando voc\xEA fechar esta janela. Uma boa
      primeira jogada: cave uma c\xE2mara ligada ao abrigo e pinte nela uma sala
      de nutrientes. Na d\xFAvida, o gloss\xE1rio (bot\xE3o ? embaixo) explica tudo.
      Explore \xE0 vontade!"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894803632128
    m_Localized: "GLOSS\xC1RIO"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603648
    m_Localized: "Gloss\xE1rio: a explica\xE7\xE3o de cada parte do jogo."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603649
    m_Localized: "O b\xE1sico"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603650
    m_Localized: Recursos e mundo
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603651
    m_Localized: Ferramentas
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603652
    m_Localized: Ambientes
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603653
    m_Localized: Formigas
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603654
    m_Localized: Menu da rainha
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603655
    m_Localized: "Evolu\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603656
    m_Localized: "Amea\xE7as"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603657
    m_Localized: Interface
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603658
    m_Localized: Como se joga
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603659
    m_Localized: "Voc\xEA n\xE3o controla cada formiga. Voc\xEA marca onde cavar
      e construir, pinta para que serve cada sala e decide que formigas a rainha
      cria; as formigas escolhem o trabalho sozinhas. A col\xF4nia cresce com nutrientes
      e com o espa\xE7o escavado."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603660
    m_Localized: "C\xE2mera"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603661
    m_Localized: "WASD, as setas ou arrastar com o bot\xE3o do meio do mouse movem
      a vista. A rolagem do mouse (ou Q e E) aproxima e afasta. O formigueiro \xE9
      a terra embaixo; a superf\xEDcie fica em cima."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603662
    m_Localized: Pausa
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603663
    m_Localized: "O bot\xE3o de pausa, no canto inferior esquerdo, ou a tecla P congelam
      o jogo. Pausado, voc\xEA ainda pode marcar e pintar; as formigas come\xE7am
      quando o jogo voltar. O menu do ESC e o gloss\xE1rio tamb\xE9m pausam enquanto
      est\xE3o abertos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603664
    m_Localized: Salvar e carregar
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603665
    m_Localized: "O menu do ESC tem Salvar partida e Carregar partida. Atalhos: F5
      salva e F9 carrega o \xFAltimo save. Continuar, no menu principal, abre a partida
      salva."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603666
    m_Localized: Fim de partida
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603667
    m_Localized: "Se os cupins matarem a rainha, a partida acaba. Na tela de fim
      de jogo d\xE1 para carregar o \xFAltimo save ou come\xE7ar um mapa novo."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603668
    m_Localized: Nutrientes (N)
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603669
    m_Localized: "A moeda da col\xF4nia. Brotam dos canteiros da sala de nutrientes.
      A rainha come nutrientes para p\xF4r cada ovo (e guarda uma reserva antes)
      e voc\xEA os gasta em Evolu\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603670
    m_Localized: Vagas
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603671
    m_Localized: "Vagas de adulta v\xEAm da \xE1rea escavada do formigueiro: cavar
      mais abre espa\xE7o para mais formigas. Vagas de cria v\xEAm das c\xE9lulas
      livres do ber\xE7\xE1rio. Sem vaga, a rainha n\xE3o p\xF5e ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603672
    m_Localized: Terra, areia e pedra
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603673
    m_Localized: "A terra cavada vira obra, canteiro e orvalho, ou \xE9 despejada
      fora. A areia solta escorre e cai; cavada, vai para o dep\xF3sito de areia
      e alimenta os pulg\xF5es. A pedra demora mais para cavar."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603674
    m_Localized: "\xC1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603675
    m_Localized: "Fica em laguinhos, escorre e vem da chuva. As formigas levam \xE1gua
      aos canteiros. A sala de orvalho e os pulg\xF5es tamb\xE9m d\xE3o \xE1gua.
      A \xE1gua amolece a terra e uma formiga presa nela pode se afogar."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603676
    m_Localized: Chuva
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603677
    m_Localized: "A chuva leve dissolve a terra despejada; a forte compacta o que
      est\xE1 solto. As duas trazem \xE1gua para o mapa. Um ataque de cupins espera
      a chuva passar."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894824603678
    m_Localized: Plantas e folhas
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797952
    m_Localized: "As plantas da superf\xEDcie crescem sozinhas. Oper\xE1rias e cortadeiras
      cortam peda\xE7os e os levam aos canteiros, \xE0 sala de orvalho ou ao dep\xF3sito
      de alimentos. Folhas tamb\xE9m saem dos res\xEDduos e dos pulg\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797953
    m_Localized: Luz
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797954
    m_Localized: "A luz vem de fora: a superf\xEDcie \xE9 clara e o formigueiro fica
      na penumbra. Cogumelos luminosos plantados nos t\xFAneis iluminam em volta."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797955
    m_Localized: Entulho
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797956
    m_Localized: "O que sobra de canteiros, salas e paredes que os cupins destroem.
      Marque o entulho com Cavar para as formigas o recolherem; com \xE1rea de res\xEDduos,
      ele vai para l\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797957
    m_Localized: Cavar
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797958
    m_Localized: "Menu Ferramenta. Marque a terra que as formigas devem tirar. Bot\xE3o
      esquerdo marca, direito desmarca. Escavadoras s\xE3o as especialistas, mas
      outras formigas tamb\xE9m cavam."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797959
    m_Localized: Construir
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797960
    m_Localized: "Menu Ferramenta. Marque c\xE9lulas vazias para as formigas preencherem
      com terra, at\xE9 acima do solo. Bot\xE3o direito desmarca."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797961
    m_Localized: Cogumelo luminoso
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797962
    m_Localized: "Menu Ferramenta. Clique numa c\xE9lula do t\xFAnel encostada na
      terra: uma formiga leva at\xE9 l\xE1 um cogumelo dos pulg\xF5es e o planta,
      e ele ilumina os t\xFAneis em volta. Para tirar um cogumelo, cave-o."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797963
    m_Localized: Dedo
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797964
    m_Localized: "Menu Ferramenta. Clique num cupim para feri-lo; n\xE3o funciona
      com o jogo pausado. Clicar na rainha for\xE7a um ovo."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797965
    m_Localized: Sala da rainha
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797966
    m_Localized: "Menu Ambientes. Onde a rainha fica e p\xF5e os ovos. Sem ela, a
      rainha n\xE3o p\xF5e."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797967
    m_Localized: Sala de nutrientes
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797968
    m_Localized: "Menu Ambientes. O cultivo: as formigas montam canteiros de terra
      fofa, planta e \xE1gua, e deles brotam os nutrientes."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797969
    m_Localized: "Ber\xE7\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797970
    m_Localized: "Menu Ambientes. Onde ovos, larvas e pupas se desenvolvem. Cada
      c\xE9lula livre dele \xE9 uma vaga de cria; a rainha precisa de ber\xE7\xE1rio
      para p\xF4r ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797971
    m_Localized: "Res\xEDduos"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797972
    m_Localized: "Menu Ambientes, liberado ao repelir o primeiro ataque de cupins.
      As formigas deixam ali entulho e restos, que se transformam. Com o pincel escolhido,
      o submenu RES\xCDDUOS define o modo da \xE1rea: restos em folhas, folhas em
      \xE1gua, ou terra em areia e \xE1gua."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797973
    m_Localized: Gotas de orvalho
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797974
    m_Localized: "Menu Ambientes. As formigas p\xF5em terra fofa e folhas no teto
      da sala, e dela pingam gotas de \xE1gua para regar os canteiros."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797975
    m_Localized: "Fazenda de pulg\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797976
    m_Localized: "Menu Ambientes, liberada pela c\xE2mara Fazenda de pulg\xF5es em
      Evolu\xE7\xE3o. Os pulg\xF5es nascem nas baias, cada uma com um cocho de areia
      e um de \xE1gua. Ordenhados pela fazendeira, comem e d\xE3o areia, folhas,
      \xE1gua e \xE0s vezes cogumelos luminosos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797977
    m_Localized: "Dep\xF3sitos"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797978
    m_Localized: "Bot\xE3o DEP\xD3SITO, no fim do menu Ambientes. H\xE1 dep\xF3sitos
      de alimentos, de constru\xE7\xE3o, de \xE1gua, de areia e de cogumelos. O que
      as formigas trazem fica guardado ali e \xE9 usado de l\xE1 primeiro; as carregadoras
      os enchem e entregam o que est\xE1 neles."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797979
    m_Localized: "Limite de \xE1rea"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797980
    m_Localized: "Cada ambiente tem um limite de c\xE9lulas que d\xE1 para pintar.
      A barra embaixo do bot\xE3o mostra o que ainda resta: laranja quando est\xE1
      acabando, vermelha quando acabou. Melhorias em Evolu\xE7\xE3o aumentam o limite."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797981
    m_Localized: Rainha
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797982
    m_Localized: "P\xF5e os ovos de onde nascem todas as formigas. Precisa da pr\xF3pria
      sala, de ber\xE7\xE1rio, de vaga e de nutrientes; o cart\xE3o Rainha diz o
      que est\xE1 faltando. Se ela morrer, a partida acaba."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797983
    m_Localized: Ovo, larva e pupa
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797984
    m_Localized: "As crias. A rainha p\xF5e o ovo, uma formiga o leva ao ber\xE7\xE1rio,
      e ele passa a larva, a pupa e por fim a formiga adulta. Cuidadoras cuidam delas
      no caminho."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797985
    m_Localized: "Oper\xE1ria"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797986
    m_Localized: "Faz de tudo um pouco e corta plantas quando est\xE1 sem outra tarefa."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797987
    m_Localized: Carregadora
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797988
    m_Localized: "A mais r\xE1pida: leva o dobro por viagem, enche os dep\xF3sitos
      e entrega o que est\xE1 neles."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797989
    m_Localized: Cortadeira
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797990
    m_Localized: "Corta as plantas da superf\xEDcie na metade do tempo e as leva
      \xE0 sala de nutrientes."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797991
    m_Localized: Escavadora
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797992
    m_Localized: "Especialista em cavar a terra marcada e despej\xE1-la fora."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797993
    m_Localized: Jardineira
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797994
    m_Localized: "Leva terra e \xE1gua aos canteiros e cuida do cultivo."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797995
    m_Localized: Cuidadora
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797996
    m_Localized: "Cuida das crias no ber\xE7\xE1rio e leva os ovos para l\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797997
    m_Localized: Soldado
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797998
    m_Localized: Combate os cupins e recolhe os corpos. Liberado ao repelir o primeiro
      ataque.
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828797999
    m_Localized: Cuspideira
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798000
    m_Localized: "Cospe \xE1cido nos cupins de longe, sem chegar perto da mordida
      deles."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798001
    m_Localized: Lixeira
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798002
    m_Localized: "Tira os corpos dos cupins, leva os itens soltos e abastece a \xE1rea
      de res\xEDduos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798003
    m_Localized: Fazendeira
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798004
    m_Localized: "Enche os cochos dos pulg\xF5es com areia e \xE1gua e os ordenha
      na fazenda."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798005
    m_Localized: Modo de postura
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798006
    m_Localized: "Autom\xE1tico: a rainha escolhe o tipo do pr\xF3ximo ovo para equilibrar
      a col\xF4nia. Tipo espec\xEDfico: ela s\xF3 p\xF5e o tipo escolhido na lista.
      Pausado: ela n\xE3o p\xF5e ovos novos, mas as crias seguem crescendo."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798007
    m_Localized: Postura diante dos cupins
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798008
    m_Localized: "Defensiva: a rainha s\xF3 se defende de quem a morde. Ofensiva:
      com cupim dentro do formigueiro, ela sai da sala atr\xE1s dele e depois volta."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798009
    m_Localized: "\xC1rvore de evolu\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798010
    m_Localized: "Bot\xE3o EVOLU\xC7\xC3O, no menu Col\xF4nia. Gaste nutrientes em
      novas classes de formiga, c\xE2maras e melhorias. Arraste para mover, role
      para aproximar e clique num n\xF3 para ver efeito, custo e requisitos."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798011
    m_Localized: Bloqueado e liberado
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798012
    m_Localized: "Bot\xF5es apagados ainda n\xE3o foram liberados; a dica do bot\xE3o
      diz o que falta. Classes e c\xE2maras v\xEAm da Evolu\xE7\xE3o; o Soldado e
      a \xE1rea de res\xEDduos, do primeiro ataque de cupins repelido."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798013
    m_Localized: Ataques de cupins
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798014
    m_Localized: "Come\xE7am quando a col\xF4nia chega a 15 formigas adultas e voltam
      de tempos em tempos. Um alerta no alto da tela avisa alguns segundos antes;
      cada cupim ganha um c\xEDrculo vermelho, ou uma seta na borda quando est\xE1
      fora da vista."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798015
    m_Localized: O que os cupins atacam
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798016
    m_Localized: "Em ordem: as crias, os pulg\xF5es, os canteiros, o que est\xE1
      dentro do ber\xE7\xE1rio, da sala de nutrientes e dos res\xEDduos, e as paredes
      em volta deles. O alerta mostra o objetivo atual. Soldados, cuspideiras, a
      rainha e o Dedo os combatem."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798017
    m_Localized: "Pulg\xE3o preto"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798018
    m_Localized: "Um pulg\xE3o mordido por um cupim fica preto: sai da fazenda e
      luta do lado dos cupins at\xE9 morrer. As formigas o ca\xE7am como a um cupim."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798019
    m_Localized: "Cart\xF5es do topo"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798020
    m_Localized: "Nutrientes: saldo e quanto foi consumido. Formigas: adultas sobre
      vagas, e ovos, larvas e pupas. Rainha: o estado dela e o que falta para p\xF4r
      ovos. Pare o mouse sobre um cart\xE3o para ver os detalhes."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798021
    m_Localized: "Painel da col\xF4nia"
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798022
    m_Localized: "Segundo bot\xE3o da barra inferior. Estat\xEDsticas das formigas
      e da produ\xE7\xE3o, e quais trabalhos ficam ativos: d\xE1 para parar uma se\xE7\xE3o
      ou limitar quantas formigas trabalham nela."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798023
    m_Localized: Sino
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798024
    m_Localized: "Chama as formigas de volta ao formigueiro: elas terminam o que
      carregam e param. Toque de novo para mand\xE1-las de volta ao trabalho."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798025
    m_Localized: Mostrar ambientes
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798026
    m_Localized: "Esconde ou mostra a pintura das salas no terreno. As salas continuam
      funcionando; \xE9 s\xF3 para ver melhor a terra e as formigas."
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798027
    m_Localized: Dicas e menu
    m_Metadata:
      m_Items: []
  - m_Id: 1425894828798028
    m_Localized: "Pare o mouse sobre qualquer bot\xE3o ou cart\xE3o para ver o que
      ele faz e o que falta. O menu Col\xF4nia, \xE0 esquerda, se recolhe e volta
      quando o mouse chega perto. O ESC abre o menu do jogo e fecha janelas."
    m_Metadata:
      m_Items: []
  - m_Id: 1658939372597248
    m_Localized: "Dep\xF3sito de serapilheira"
    m_Metadata:
      m_Items: []
  - m_Id: 1658939401957376
    m_Localized: "Dep\xF3sito de serapilheira: guarda as folhas secas e os gravetos
      mi\xFAdos cavados no bioma Serapilheira, \xE0 direita do formigueiro."
    m_Metadata:
      m_Items: []
  - m_Id: 1658939406151680
    m_Localized: "Dep\xF3sito de serapilheira"
    m_Metadata:
      m_Items: []
  - m_Id: 1658939406151681
    m_Localized: "Libera o pincel do dep\xF3sito de serapilheira, o insumo do bioma
      Serapilheira"
    m_Metadata:
      m_Items: []
  - m_Id: 1658949350846464
    m_Localized: "DEP\xD3SITO DE SERAPILHEIRA"
    m_Metadata:
      m_Items: []
  - m_Id: 1665864411770880
    m_Localized: "Dep\xF3sito de n\xE9ctar"
    m_Metadata:
      m_Items: []
  - m_Id: 1665864415965184
    m_Localized: "Dep\xF3sito de n\xE9ctar: guarda as gotas que as flores do Canteiro
      de flores, \xE0 esquerda do formigueiro, soltam no ch\xE3o. Sem ele, as gotas
      ficam onde ca\xEDram."
    m_Metadata:
      m_Items: []
  - m_Id: 1665873270140928
    m_Localized: "DEP\xD3SITO DE N\xC9CTAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1672398994796544
    m_Localized: "Dep\xF3sito de min\xE9rio"
    m_Metadata:
      m_Items: []
  - m_Id: 1672398998990848
    m_Localized: "Dep\xF3sito de min\xE9rio: guarda o cobre, o ferro e o ouro cavados
      dos veios. Sem ele, o min\xE9rio fica onde foi cavado."
    m_Metadata:
      m_Items: []
  - m_Id: 1672407807029248
    m_Localized: "DEP\xD3SITO DE MIN\xC9RIO"
    m_Metadata:
      m_Items: []
  - m_Id: 1675230900776960
    m_Localized: "Fundi\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971264
    m_Localized: Forja
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971265
    m_Localized: "Armaz\xE9m de ferramentas e armas"
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971266
    m_Localized: "Armaz\xE9m de roupas e armaduras"
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971267
    m_Localized: "Fundi\xE7\xE3o: as formigas trazem min\xE9rio e serapilheira; cada
      min\xE9rio com uma serapilheira vira uma barra do mesmo metal em 20 s."
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971268
    m_Localized: 'Forja: as formigas trazem as barras; duas barras do mesmo metal
      viram, em 30 s, a ferramenta, a arma ou a armadura que mais falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971269
    m_Localized: "Armaz\xE9m de ferramentas e armas: a escavadora e a oper\xE1ria
      buscam aqui a ferramenta; soldado e cuspideira, a arma."
    m_Metadata:
      m_Items: []
  - m_Id: 1675230904971270
    m_Localized: "Armaz\xE9m de roupas e armaduras: soldado e cuspideira buscam aqui
      a armadura."
    m_Metadata:
      m_Items: []
  - m_Id: 1675236919603200
    m_Localized: "FUNDI\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 1675237443891200
    m_Localized: FORJA
    m_Metadata:
      m_Items: []
  - m_Id: 1675240950329344
    m_Localized: "ARMAZ\xC9M DE FERRAMENTAS E ARMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 1675241487200256
    m_Localized: "ARMAZ\xC9M DE ROUPAS E ARMADURAS"
    m_Metadata:
      m_Items: []
  - m_Id: 1792060155883520
    m_Localized: "N\xCDVEL {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237474054144
    m_Localized: FAZENDA
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248448
    m_Localized: COLETA
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248449
    m_Localized: CULTIVO
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248450
    m_Localized: ORVALHO
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248451
    m_Localized: "BER\xC7\xC1RIO"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248452
    m_Localized: RAINHA
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248453
    m_Localized: FORMIGAS
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248454
    m_Localized: "OPER\xC1RIA"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248455
    m_Localized: OBRA
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248456
    m_Localized: "ESCAVA\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248457
    m_Localized: "DEP\xD3SITOS"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248458
    m_Localized: "RES\xCDDUOS"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248459
    m_Localized: GUARDA
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248460
    m_Localized: "MIN\xC9RIOS"
    m_Metadata:
      m_Items: []
  - m_Id: 1799237478248461
    m_Localized: FORJA
    m_Metadata:
      m_Items: []
  - m_Id: 1806537463033856
    m_Localized: "PROFUNDIDADE INSUFICIENTE PARA ESTE N\xCDVEL"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
