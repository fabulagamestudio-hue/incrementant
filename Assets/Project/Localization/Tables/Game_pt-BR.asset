      m_Items: []
  - m_Id: 391819835707405
    m_Localized: "TOTAL {0} \u2192 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707406
    m_Localized: TOTAL {0} (COMPLETA)
    m_Metadata:
