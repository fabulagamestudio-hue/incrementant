      m_Items: []
  - m_Id: 332726722859013
    m_Localized: 'Building storage: keeps the dug soil. With it, builds, beds and
      the dew room only use the soil from here.'
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859014
    m_Localized: 'Water storage: keeps the water taken from the map. With it, the
      beds are only watered with the water from here.'
