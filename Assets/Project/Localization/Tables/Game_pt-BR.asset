      m_Items: []
  - m_Id: 391819839901738
    m_Localized: Guarda real
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901739
    m_Localized: "No aviso de ataque, at\xE9 4 soldados cercam a rainha"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901740
    m_Localized: "C\xE2mara real ampliada"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901741
    m_Localized: "Cada adulta ocupa 4% menos espa\xE7o por n\xEDvel: cabem mais formigas"
