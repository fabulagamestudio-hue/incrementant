    m_Metadata:
      m_Items: []
  - m_Id: 316986955370503
    m_Localized: BOTAR OVOS
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370504
    m_Localized: COLETAR RECURSOS
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370505
    m_Localized: TUDO ATIVO
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370506
    m_Localized: FORMIGAS
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370507
    m_Localized: Adultas
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370508
    m_Localized: Crias
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370509
    m_Localized: Sem trabalho
    m_Metadata:
      m_Items: []
  - m_Id: 316986955370510
    m_Localized: Lutando
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564800
    m_Localized: POR TIPO
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564801
    m_Localized: TRABALHANDO EM
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564802
    m_Localized: RAINHA
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564803
    m_Localized: 'Sino tocado: recolhidas'
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564804
    m_Localized: "ONDE EST\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564805
    m_Localized: "PRODU\xC7\xC3O POR SEGUNDO"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564806
    m_Localized: "Escava\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564807
    m_Localized: "Constru\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564808
    m_Localized: Coleta de plantas
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564809
    m_Localized: Alimentar a rainha
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564810
    m_Localized: "Ber\xE7\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564811
    m_Localized: Sala de nutrientes
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564812
    m_Localized: Gotas de orvalho
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564813
    m_Localized: "Res\xEDduos"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564814
    m_Localized: Exterior
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564815
    m_Localized: "T\xFAneis"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564816
    m_Localized: Sala da rainha
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564817
    m_Localized: "Ber\xE7\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564818
    m_Localized: Sala de nutrientes
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564819
    m_Localized: Gotas de orvalho
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564820
    m_Localized: "Res\xEDduos"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564821
    m_Localized: "Nutriente \xE0 rainha"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564822
    m_Localized: Nutriente brotado
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564823
    m_Localized: Planta colhida
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564824
    m_Localized: Terra escavada
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564825
    m_Localized: PARADA
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564826
    m_Localized: AGORA {0}
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564827
    m_Localized: SEM LIMITE
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564828
    m_Localized: "M\xC1X {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564829
    m_Localized: No ninho, pondo ovos
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564830
    m_Localized: Coletando recursos
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564831
    m_Localized: 'A rainha fica na sala dela pondo ovos. Agora: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564832
    m_Localized: "A rainha coleta e n\xE3o p\xF5e ovos fora da sala. Agora: {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564833
    m_Localized: "Clique para ligar ou parar. Parada, nenhuma formiga nova entra;
      quem est\xE1 nela termina o que carrega."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564834
    m_Localized: "Diminui o limite de formigas nesta se\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564835
    m_Localized: Aumenta o limite; acima do total de formigas, fica sem limite.
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564836
    m_Localized: "Liga todas as se\xE7\xF5es e tira todos os limites."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564837
    m_Localized: "A rainha fica na sala dela e p\xF5e ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564838
    m_Localized: "A rainha sai para coletar: come o nutriente guardado e corta e
      carrega plantas de fora. Enquanto isso, n\xE3o p\xF5e ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564839
    m_Localized: "Escava\xE7\xE3o: cavar a terra marcada e lev\xE1-la para fora."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564840
    m_Localized: "Constru\xE7\xE3o: buscar terra na pilha de fora e montar as obras."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564841
    m_Localized: "Coleta de plantas: cortar plantas de fora e levar os peda\xE7os
      aos canteiros."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564842
    m_Localized: "Alimentar a rainha: levar o nutriente guardado at\xE9 ela."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564843
    m_Localized: "Ber\xE7\xE1rio: levar os ovos e cuidar das crias."
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564844
    m_Localized: 'Sala de nutrientes: montar canteiros, regar e cuidar do que brota.'
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564845
    m_Localized: 'Gotas de orvalho: terra fofa no teto e cuidado das gotas.'
    m_Metadata:
      m_Items: []
  - m_Id: 316986959564846
    m_Localized: "Res\xEDduos: desmembrar cupins mortos e levar os restos."
    m_Metadata:
      m_Items: []
  - m_Id: 320654177964032
    m_Localized: COLETAR NUTRIENTE
    m_Metadata:
      m_Items: []
  - m_Id: 320654177964033
    m_Localized: Coletando nutriente
    m_Metadata:
      m_Items: []
  - m_Id: 320654177964034
    m_Localized: 'Na sala de nutrientes, comendo cada nutriente pronto (sem ovos).
      Agora: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 320654177964035
    m_Localized: "A rainha vai \xE0 sala de nutrientes, fica l\xE1 e come cada nutriente
      assim que fica pronto, sem cortar plantas. Enquanto isso, n\xE3o p\xF5e ovos."
    m_Metadata:
      m_Items: []
  - m_Id: 332726718664704
    m_Localized: "Dep\xF3sito de alimentos"
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859008
    m_Localized: "Dep\xF3sito de constru\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859009
    m_Localized: "Dep\xF3sito de \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859010
    m_Localized: "DEP\xD3SITO"
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859011
    m_Localized: "Dep\xF3sitos de alimentos, de constru\xE7\xE3o, de \xE1gua, de
      areia e de cogumelos. O que as formigas trazem de fora fica guardado ali, sem
      fechar a passagem, e \xE9 usado de l\xE1 primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859012
    m_Localized: "Dep\xF3sito de alimentos: guarda os peda\xE7os de planta cortados.
      Com ele, os canteiros e a sala de orvalho s\xF3 recebem planta daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859013
    m_Localized: "Dep\xF3sito de constru\xE7\xE3o: guarda a terra cavada. Com ele,
      obras, canteiros e a sala de orvalho s\xF3 usam a terra daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859014
    m_Localized: "Dep\xF3sito de \xE1gua: guarda a \xE1gua tirada do mapa. Com ele,
      os canteiros s\xF3 s\xE3o regados com a \xE1gua daqui."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859015
    m_Localized: "Falta: pintar o dep\xF3sito (Ambientes > Dep\xF3sito)."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859016
    m_Localized: "Falta: espa\xE7o livre. Cave o dep\xF3sito; qualquer c\xE9lula
      vazia guarda um item."
    m_Metadata:
      m_Items: []
  - m_Id: 332726722859017
    m_Localized: 'Funcionando: {0} guardados, {1} vagas livres.'
    m_Metadata:
      m_Items: []
  - m_Id: 332730325766144
    m_Localized: "DEP\xD3SITO DE ALIMENTOS"
    m_Metadata:
      m_Items: []
  - m_Id: 332730858442752
    m_Localized: "DEP\xD3SITO DE CONSTRU\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 332731399507968
    m_Localized: "DEP\xD3SITO DE \xC1GUA"
    m_Metadata:
      m_Items: []
  - m_Id: 350737034874880
    m_Localized: Arraste para escolher o limite; no fim do trilho, fica sem limite.
    m_Metadata:
      m_Items: []
  - m_Id: 381798674567168
    m_Localized: "Enchendo dep. \xE1gua"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707392
    m_Localized: ORVALHO
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707393
    m_Localized: OBRA
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707394
    m_Localized: EXTERIOR
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707395
    m_Localized: DEFESA
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707396
    m_Localized: "C\xC2MARA REAL"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707397
    m_Localized: "ARRASTE PARA MOVER  \xB7  RODA DO MOUSE PARA ZOOM"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707398
    m_Localized: "M\xC1X"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707399
    m_Localized: PROFUNDIDADE {0}
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707400
    m_Localized: "TERRA N\xC3O ESCAVADA \xB7 ABRE COM PROFUNDIDADE {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707401
    m_Localized: "C\xC2MARA"
    m_Metadata:
      m_Items: []
  - m_Id: 391819835707402
