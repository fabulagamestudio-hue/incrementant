      m_Items: []
  - m_Id: 391819839901764
    m_Localized: "Brota\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901765
    m_Localized: "Plantas de fora crescem 6% mais r\xE1pido por n\xEDvel"
