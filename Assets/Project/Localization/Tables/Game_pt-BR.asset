      m_Items: []
  - m_Id: 391819839901758
    m_Localized: "Reservat\xF3rio"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901759
    m_Localized: "A sala de orvalho guarda +4 de \xE1gua por n\xEDvel"
