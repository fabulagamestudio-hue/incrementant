    m_Localized: "Nutrientes ficam prontos para levar 4% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901748
    m_Localized: Leitos aquecidos
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901749
    m_Localized: "Larvas e pupas crescem 3% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901750
    m_Localized: Vagas extras
    m_Metadata:
      m_Items: []
