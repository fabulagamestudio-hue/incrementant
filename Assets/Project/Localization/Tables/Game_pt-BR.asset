      m_Items: []
  - m_Id: 391819839901742
    m_Localized: Fungo vigoroso
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901743
    m_Localized: "Canteiros ficam prontos 8% mais r\xE1pido por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901744
    m_Localized: Colheita nutritiva
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901745
    m_Localized: "Cada entrega de nutriente vale 5% mais por n\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901746
    m_Localized: "Cura r\xE1pida"
    m_Metadata:
      m_Items: []
