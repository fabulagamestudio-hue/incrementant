  - m_Id: 23902560256
    m_Localized: FINGER
    m_Metadata:
      m_Items: []
  - m_Id: 23906754560
    m_Localized: QUEEN ROOM
    m_Metadata:
      m_Items: []
  - m_Id: 23910948864
    m_Localized: NUTRIENT ROOM
    m_Metadata:
      m_Items: []
  - m_Id: 23919337472
    m_Localized: DEW DROPS
    m_Metadata:
      m_Items: []
  - m_Id: 22553224814592
    m_Localized: 'Map tools: dig soil, mark building work, and the finger, which
      hurts termites.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786112
    m_Localized: Anthill rooms. Paint where the queen, the farm, the brood, the waste
      and the dew go.
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786113
    m_Localized: 'Queen: choose the type of ant she lays, how she reacts to termites,
      and follow the breeding.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786114
    m_Localized: 'Evolution: spend nutrients on new ant classes and upgrades.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786115
    m_Localized: Pauses or resumes the simulation (P key).
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786116
    m_Localized: Speed {0}x (key {1}).
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786117
    m_Localized: 'Dig: mark the soil the diggers must remove. Left button marks,
      right button unmarks.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786118
    m_Localized: 'Build: mark empty cells for the ants to fill with soil, even above
      the ground. Right button unmarks.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786119
    m_Localized: 'Finger: click a termite to hurt it. Clicking the queen forces an
      egg.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786120
    m_Localized: Left paints, right erases.
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786121
    m_Localized: 'Queen room: where she stays and lays eggs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786122
    m_Localized: 'Nutrient room: the farm. Ants build beds (loose soil, plant and
      water) and nutrients sprout from them.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786123
    m_Localized: 'Nursery: where eggs, larvae and pupae develop. Brood slots come
      from its free cells.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786124
    m_Localized: 'Waste: where ants leave rubble and scraps to decompose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786125
    m_Localized: 'Waste: locked until you repel the first termite attack.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786126
    m_Localized: 'Dew drops: ants place loose soil and leaves on the room''s ceiling,
      and water drops fall from it to water the beds.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786127
    m_Localized: 'Nutrients: the currency for new ants. The queen eats what the ants
      store in the nutrient room.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786128
    m_Localized: Balance {0} N; the queen keeps {1} N in reserve before laying an
      egg.
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786129
    m_Localized: 'Ants: adults / adult slots (from the dug area of the anthill) and
      brood.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786130
    m_Localized: 'Now: {0} of {1} slots; {2} brood in {3} nursery slots.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786131
    m_Localized: 'Queen: needs her own room, a nursery, a free slot and nutrients
      to lay eggs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786132
    m_Localized: 'Common: does a bit of everything and cuts plants when it has no
      other task.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786133
    m_Localized: 'Carrier: the fastest; carries eggs and hauls more material per
      trip.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786134
    m_Localized: 'Cutter: cuts surface plants in half the time and takes them to
      the nutrient room.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786135
    m_Localized: 'Digger: specialist in digging the marked soil and dumping it outside.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786136
    m_Localized: 'Gardener: brings soil and water to the beds and tends the farm.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786137
    m_Localized: 'Nurse: looks after the brood in the nursery and carries eggs there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786138
    m_Localized: 'Soldier: fights the termites and clears the bodies.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786139
    m_Localized: 'Locked: unlock node {0} in Evolution.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786140
    m_Localized: Click to make the queen lay only this type.
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786141
    m_Localized: 'Automatic: the queen picks the next egg''s type to balance the
      colony.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786142
    m_Localized: 'Specific type: the queen lays only the type chosen below.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786143
    m_Localized: 'Paused: the queen lays no new eggs (existing brood keeps growing).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786144
    m_Localized: 'Defensive: the queen only defends herself from termites that come
      close.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786145
    m_Localized: 'Offensive: the queen goes after the termites to attack them.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786146
    m_Localized: 'Missing: paint the queen room (Environments menu).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786147
    m_Localized: 'Missing: dig out the painted room, which is still solid soil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786148
    m_Localized: 'Missing: connect the queen room to the rest of the anthill with
      a tunnel.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786149
    m_Localized: 'Room ready: the queen is in it ({0} cells).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786150
    m_Localized: 'Room ready ({0} cells): the queen is heading there.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786151
    m_Localized: 'Missing: paint the nutrient room (Environments menu).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786152
    m_Localized: 'No beds yet: ants build one when they bring loose soil while digging.
      Nutrients ready: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786153
    m_Localized: 'Missing: room for a bed. Dig the room with solid floor and 2 cells
      of height. Nutrients ready: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786154
    m_Localized: 'Producing: {0} beds ({1} awaiting a plant, {2} awaiting water,
      {3} sprouting). Nutrients ready: {4}.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786155
    m_Localized: 'Harvest paused: no bed needs a plant.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786156
    m_Localized: 'Missing: paint the nursery (Environments menu).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786157
    m_Localized: 'Missing: dig the nursery; there is no brood slot yet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786158
    m_Localized: 'Working: {0} brood in {1} slots.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786159
    m_Localized: 'Missing: paint the waste area (Environments menu).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786160
    m_Localized: 'Missing: free space. Dig the area, with free floor to leave waste
      on.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786161
    m_Localized: 'Working: {0} free spots, {1} waste pieces decomposing, {2} already
      deposited.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786162
    m_Localized: 'Missing: paint the room (Environments menu).'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786163
    m_Localized: 'Step 1 of 3: bringing loose soil ({0} spots). Ants take it from
      the pile outside or from what they dig.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786164
    m_Localized: 'Step 2 of 3: bringing leaves ({0} spots). Cutters and gardeners
      cut them; there must be plants on the surface.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786165
    m_Localized: 'Producing: step 3 of 3, the room drips water. Drops so far: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786166
    m_Localized: 'Missing: room for the loose soil. Dig the room at least 4 cells
      high.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786167
    m_Localized: 'Queen paused: no new eggs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786168
    m_Localized: 'Missing: paint and dig the queen room.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786169
    m_Localized: The queen is outside her room.
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786170
    m_Localized: 'Missing: paint and dig a nursery.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786171
    m_Localized: 'Nursery full: expand it.'
    m_Metadata:
      m_Items: []
  - m_Id: 22553245786172
    m_Localized: 'No adult slot: dig more anthill.'
    m_Metadata:
      m_Items: []
