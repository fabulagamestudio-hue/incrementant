      m_Items: []
  - m_Id: 391819839901754
    m_Localized: "Conserva\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 391819839901755
    m_Localized: "Alimentos estragam 5% mais devagar no dep\xF3sito por n\xEDvel"
